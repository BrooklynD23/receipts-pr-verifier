diff --git a/src/packaging/utils.py b/src/packaging/utils.py
--- a/src/packaging/utils.py
+++ b/src/packaging/utils.py
@@ -10,5 +10,13 @@
-def canonicalize_version(version):
-    """Return a canonical form of a version string."""
+def canonicalize_version(version, *, strip_trailing_zero=True):
+    """Return a canonical form of a version string.
+
+    If ``strip_trailing_zero`` is true, drop a single trailing ``.0``
+    release segment so ``"1.0"`` canonicalizes to ``"1"``.
+    """
     if isinstance(version, str):
         version = Version(version)
+    release = version.release
+    if strip_trailing_zero and len(release) > 1 and release[-1] == 0:
+        release = release[:-1]
+        version = Version(".".join(str(part) for part in release))
     return str(version)
diff --git a/tests/test_utils.py b/tests/test_utils.py
--- a/tests/test_utils.py
+++ b/tests/test_utils.py
@@ -30,5 +30,13 @@
 def test_canonicalize_version_simple():
     assert canonicalize_version("1.0.0") == "1.0.0"
 
 
+def test_canonicalize_version_strips_trailing_zero():
+    assert canonicalize_version("1.0") == "1"
+
+
+def test_canonicalize_version_keeps_trailing_zero():
+    assert canonicalize_version("1.0", strip_trailing_zero=False) == "1.0"
+
