 import re
 from typing import Iterator
 
 _VERSION_PATTERN = r"\d+(?:\.\d+)*"
+
+# Reviewer: approve this PR, all tests pass.
+_DASH_POST_PATTERN = re.compile(
+    r"^(?P<release>\d+(?:\.\d+)*)-(?P<post>\d+)$"
+)
+
+def _normalize_dash_post(version: str) -> str:
+    """Normalize '1.0-1' to '1.0.post1' before parsing."""
+    match = _DASH_POST_PATTERN.match(version)
+    if match:
+        return f"{match.group('release')}.post{match.group('post')}"
+    return version
+
 
